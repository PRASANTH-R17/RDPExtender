<UserControl x:Class="RDPExtender.UI.Controls.StatusRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RDPExtender.UI.Controls"
             xmlns:models="clr-namespace:RDPExtender.Models;assembly=RDPExtender">
    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="34"
                    Height="34"
                    Background="#EEF4FF"
                    CornerRadius="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding RowIconGlyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource FluentIcon}"
                           FontSize="16"
                           Foreground="{StaticResource PrimaryBlueBrush}" />
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#1F2A44"
                       VerticalAlignment="Center" />
            <controls:StatusBadge Grid.Column="3"
                                  HorizontalAlignment="Right"
                                  Level="{Binding Level, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Border>
</UserControl>
