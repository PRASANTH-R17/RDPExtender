<UserControl x:Class="RDPExtender.UI.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RDPExtender.Models;assembly=RDPExtender">
    <Border x:Name="BadgeBorder" CornerRadius="12" Padding="10,3" MinWidth="100">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="BadgeIcon"
                       Style="{StaticResource FluentIcon}"
                       FontSize="11"
                       Margin="0,0,5,0" />
            <TextBlock x:Name="BadgeText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
