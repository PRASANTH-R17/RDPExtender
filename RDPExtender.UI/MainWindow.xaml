<Window x:Class="RDPExtender.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RDPExtender.UI.Controls"
        Title="RDPExtender"
        Width="880"
        Height="680"
        ResizeMode="CanMinimize"
        Icon="/Assets/rdpextender-favicon-256.png"
        FontFamily="/Assets/Fonts/#Inter Variable Text"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource PageBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="28,16,28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="72"
                        Height="72"
                        Background="#EEF4FF"
                        BorderBrush="#D9E4FF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8"
                        Margin="0,0,14,0">
                    <Image Source="/Assets/rdpextender-logo-512-transparent.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RDPExtender"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBlueBrush}" />
                    <TextBlock Text="Extend Remote Desktop safely"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Status card -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           Style="{StaticResource FluentIcon}"
                                           FontSize="15"
                                           Foreground="{StaticResource PrimaryBlueBrush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Status" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <Button Style="{StaticResource IconOnlyButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding RefreshStatusCommand}"
                                    ToolTip="Refresh status">
                                <TextBlock Text="&#xE72C;"
                                           Style="{StaticResource FluentIcon}"
                                           FontSize="12"
                                           Foreground="{StaticResource PrimaryBlueBrush}" />
                            </Button>
                        </Grid>

                        <controls:StatusRow Label="Windows Compatibility"
                                            RowIconGlyph="&#xEA18;"
                                            StatusText="{Binding OsStatusText}"
                                            Level="{Binding OsStatusLevel}" />
                        <controls:StatusRow Label="Multiple User Access"
                                            RowIconGlyph="&#xE7FC;"
                                            StatusText="{Binding PatchStatusText}"
                                            Level="{Binding PatchStatusLevel}" />
                        <controls:StatusRow Label="Restore Point"
                                            RowIconGlyph="&#xE74E;"
                                            StatusText="{Binding BackupStatusText}"
                                            Level="{Binding BackupStatusLevel}" />
                        <controls:StatusRow Label="Remote Desktop Service"
                                            RowIconGlyph="&#xE713;"
                                            StatusText="{Binding ServiceStatusText}"
                                            Level="{Binding ServiceStatusLevel}" />
                    </StackPanel>
                </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding PatchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Enable Multiple User Access" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RevertCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource FluentIcon}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Restore Original Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

            <!-- Logs card: fills remaining vertical space -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;"
                                           Style="{StaticResource FluentIcon}"
                                           FontSize="15"
                                           Foreground="{StaticResource PrimaryBlueBrush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="Logs" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <Button Style="{StaticResource ClearLogsButton}"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ClearLogsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" FontSize="12" Margin="0,0,5,0" />
                                    <TextBlock Text="Clear Logs" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#FAFAFA"
                                Padding="12">
                            <RichTextBox x:Name="LogBox"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False"
                                         IsDocumentEnabled="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Padding="0"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled">
                                <FlowDocument PageWidth="2000">
                                    <FlowDocument.Resources>
                                        <Style TargetType="Paragraph">
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                        </Style>
                                    </FlowDocument.Resources>
                                </FlowDocument>
                            </RichTextBox>
                        </Border>
                    </Grid>
                </Border>
        </Grid>

        <!-- Bottom status bar -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,8">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BottomBarIconGlyph}"
                               Style="{StaticResource FluentIcon}"
                               FontSize="14"
                               Margin="0,0,6,0">
                        <TextBlock.Foreground>
                            <Binding Path="BottomBarLevel" Converter="{StaticResource StatusLevelToForegroundConverter}" />
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="{Binding BottomBarMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding AppVersion}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
