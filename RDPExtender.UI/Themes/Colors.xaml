<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryBlueColor">#2563EB</Color>
    <Color x:Key="PrimaryBlueDarkColor">#1D4ED8</Color>
    <Color x:Key="PageBackgroundColor">#F3F4F6</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#E5E7EB</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="SuccessFgColor">#16A34A</Color>
    <Color x:Key="SuccessBgColor">#DCFCE7</Color>
    <Color x:Key="WarningFgColor">#E11D2E</Color>
    <Color x:Key="WarningBgColor">#FEEDEE</Color>
    <Color x:Key="ErrorFgColor">#DC2626</Color>
    <Color x:Key="ErrorBgColor">#FEE2E2</Color>

    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlueColor}" />
    <SolidColorBrush x:Key="PrimaryBlueDarkBrush" Color="{StaticResource PrimaryBlueDarkColor}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SuccessFgBrush" Color="{StaticResource SuccessFgColor}" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
    <SolidColorBrush x:Key="WarningFgBrush" Color="{StaticResource WarningFgColor}" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />
    <SolidColorBrush x:Key="ErrorFgBrush" Color="{StaticResource ErrorFgColor}" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}" />
</ResourceDictionary>
