<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RDPExtender</RootNamespace>
    <!-- Keep the historical CLI binary name `RDPExtender.exe`. -->
    <AssemblyName>RDPExtender</AssemblyName>
    <AssemblyVersion>3.0.1</AssemblyVersion>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RDPExtender\RDPExtender.csproj" />
  </ItemGroup>

</Project>
